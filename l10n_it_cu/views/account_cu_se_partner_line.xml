                        </div>
                        <div class="col-md-3">
                            <label for="contributions_paid" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2 bg-white" />
                        <div class="col-md-1" />
                        <div class="col-md-3">
                            <field name="other_contributions_amount" class="w-auto m-2" />
                        </div>
                        <div class="col-md-3">
                            <field name="contributions_due" class="w-auto m-2" />
                        </div>
                        <div class="col-md-3">
                            <field name="contributions_paid" class="w-auto m-2" />
                        </div>
                    </div>

                    <notebook>
                        <field name="with_account_move_lines" invisible="1" />
                        <field name="with_invoices" invisible="1" />

                        <page
                            string="Invoices"
                            name="account_invoices"
                            attrs="{'invisible': [('with_invoices', '=', False)]}"
                        >
                            <field name="invoice_ids" nolabel="1" />
                        </page>

                        <page
                            string="Account moves lines"
                            name="account_move_lines"
                            attrs="{'invisible': [('with_account_move_lines', '=', False)]}"
                        >
                            <field name="account_move_line_ids" nolabel="1" />
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
