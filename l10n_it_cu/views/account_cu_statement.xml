<?xml version="1.0" ?>
<odoo>

    <record id="view_account_cu_statement_tree" model="ir.ui.view">
        <field name="name">account.cu.statement.tree</field>
        <field name="model">account.cu.statement</field>
        <field name="arch" type="xml">
            <tree string="CU Statements">
                <field name="name" />
                <field name="date_start" />
                <field name="date_stop" />
                <field name="income_type_ids" widget="many2many_tags" />
                <field name="employer_id" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <record id="view_account_cu_statement_search" model="ir.ui.view">
        <field name="name">account.cu.statement.search</field>
        <field name="model">account.cu.statement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="employer_id" />
                <field name="date_start" />
                <field name="date_stop" />
            </search>
        </field>
    </record>

    <record id="view_account_cu_statement_form" model="ir.ui.view">
        <field name="name">account.cu.statement.form</field>
        <field name="model">account.cu.statement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="button_statement_compute"
                        string="Compute"
                        type="object"
                        confirm="Are you sure? The existing lines will be deleted and recomputed!"
                    />
                    <button name="button_statement_print" string="Print" type="object" />
                    <button name="button_statement_export" string="Export" type="object" />
                    <button
                        name="%(l10n_it_cu.action_cu_file_import_ade_protocol)d"
                        string="Import ADE Protocol CU"
                        type="action"
                        confirm="Are you sure you want to import new protocols?"
                    />
                    <button name="button_statement_copy" string="Copy Statement" type="object" />
                    <button name="button_statement_cancel" string="Cancel Statement" type="object" />
                    <button name="button_statement_substitute" string="Substitute Statement" type="object" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Description" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group name="params">
                        <group>
                            <field name="statement_type_id" />
                            <field name="date_start" />
                            <field name="date_stop" />
                        </group>
                        <group>
                            <field name="company_id" />
                            <field name="parent_id" attrs="{'invisible': [('parent_id', '=', False)]}" readonly="1" />
                            <field name="record_ab_txt" groups="base.group_no_one" />
                            <field name="income_type_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <newline/>
                    <group name="employer" string="Employer">
                        <field name="employer_id" />
                    </group>
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="employer_data_1"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-4">
                            <label for="employer_fiscalcode" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="employer_lastname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="employer_firstname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="employer_fiscalcode" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="employer_lastname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="employer_firstname" class="w-auto m-2" />
                        </div>
                    </div>
                    <!-- Employer: Line 2 -->
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="employer_data_2"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-4">
                            <label for="employer_city" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="employer_province" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="employer_zip" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="employer_address" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="employer_city" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="employer_province" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="employer_zip" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="employer_address" class="w-auto m-2" />
                        </div>
                    </div>
                    <!-- Employer: Line 3 -->
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="employer_data_3"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-4">
                            <label for="employer_phone" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="employer_email" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="employer_ateco_id" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="employer_headquarters" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="employer_phone" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="employer_email" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="employer_ateco_id" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="employer_headquarters" class="w-auto m-2" />
                        </div>
                    </div>

                    <group name="taxpayer" string="Taxpayer" />
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="taxpayer_data_1"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-5">
                            <label for="taxpayer_fiscalcode" class="w-auto m-2" />
                        </div>
                        <div class="col-md-7">
                            <label for="taxpayer_appointment_code_id" class="w-auto m-2" />
                        </div>
                        <div class="col-md-5">
                            <field name="taxpayer_fiscalcode" class="w-auto m-2" />
                        </div>
                        <div class="col-md-7">
                            <field name="taxpayer_appointment_code_id" class="w-auto m-2" />
                        </div>
                    </div>
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="taxpayer_data_2"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-6">
                            <label for="taxpayer_lastname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-6">
                            <label for="taxpayer_firstname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-6">
                            <field name="taxpayer_lastname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-6">
                            <field name="taxpayer_firstname" class="w-auto m-2" />
                        </div>
                    </div>
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="taxpayer_data_3"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-4">
                            <label for="statement_date" class="w-auto m-2" />
                        </div>
                        <div class="col-md-8">
                            <label for="taxpayer_sign" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="statement_date" class="m-2" />
                        </div>
                        <div class="col-md-8">
                            <field name="taxpayer_sign" class="m-2" />
                        </div>
                    </div>

                    <group name="delegate" string="Delegate" />
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="delegate_data_1"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-12">
                            <label for="delegate_fiscalcode" class="w-auto m-2" />
                            <field name="delegate_fiscalcode" class="w-auto m-2" />
                        </div>
                    </div>
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="delegate_data_2"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-12">
                            <label for="delegate_commitment" class="w-auto m-2" />
                            <field name="delegate_commitment" class="w-auto m-2" />
                        </div>
                    </div>
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="delegate_data_3"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-6">
                            <label for="delegate_date" class="w-auto m-2" />
                            <field name="delegate_date" class="w-auto m-2" />
                        </div>
                        <div class="col-md-6">
                            <label for="delegate_sign" class="m-2" />
                            <field name="delegate_sign" class="m-2" />
                        </div>
                    </div>

                    <group name="statement_sign" string="Statement Sign" />
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="statement_sign"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-6">
                            <label for="certification_count" class="w-auto m-2" />
                            <field name="certification_count" class="w-auto m-2" />
                        </div>
                        <div class="col-md-6">
                            <label for="statement_sign" class="m-2" />
                            <field name="statement_sign" class="m-2" />
                        </div>
                    </div>

                    <notebook>
                    <!--
                        Partner
                    -->
                        <page
                            name="se_partner"
                            string="Self-Employment certification, commissions and different incomes"
                        >
                            <field name="certification_se_lines_ids">
                                <tree name="se_partner">
                                    <field name="confirmed" widget="boolean_toggle" />
                                    <field name="fiscalcode" />
                                    <field name="lastname" />
                                    <field name="firstname" />
                                    <field name="gender" />
                                    <field name="birth_date" />
                                    <field name="error" />
                                    <field name="error_msg" />
                                </tree>
                            </field>
                        </page>

                        <page
                            name="se_childs"
                            string="Child Statements"
                            attrs="{'invisible': [('child_ids', '=', [])]}"
                        >
                            <field name="child_ids" readonly="1" />
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="action_account_cu_statement" model="ir.actions.act_window">
        <field name="name">CU Statements</field>
        <field name="res_model">account.cu.statement</field>
        <field name="view_id" ref="l10n_it_cu.view_account_cu_statement_tree" />
    </record>

    <menuitem
        id="menu_account_cu_main"
        name="CU Statements"
        parent="l10n_it_withholding_tax.wt_main"
        sequence="50"
    />

    <menuitem
        id="menu_cu_statements"
        name="CU Statements"
        action="l10n_it_cu.action_account_cu_statement"
        parent="menu_account_cu_main"
        sequence="1"
    />

</odoo>
