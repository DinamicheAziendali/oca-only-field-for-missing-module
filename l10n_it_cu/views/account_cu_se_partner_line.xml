                            <field name="company_code" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="category_id" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4" />
                    </div>

                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="line_data_6"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-2 bg-white" />
                        <div class="col-md-1" />
                        <div class="col-md-3">
                            <label for="employer_contributions_social_security_payments" class="w-auto m-2" />
