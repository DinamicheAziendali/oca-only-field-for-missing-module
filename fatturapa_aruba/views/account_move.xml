<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="invoice_tree_inherit" model="ir.ui.view">
        <field name="name">invoice.tree.aruba.state</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="aruba_state"/>
            </xpath>
        </field>
    </record>

    <record id="invoice_form_inherit" model="ir.ui.view">
        <field name="name">invoice.form.aruba.state</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='invoice_user_id']" position="after">
                <field name="aruba_state"/>
            </xpath>
        </field>
    </record>

    <record id="aruba_account_move_filter_view_inherit" model="ir.ui.view">
        <field name="name">aruba.account.move.filter.view.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_fatturapa_out.view_account_invoice_fatturapa_out_filter" />
        <field name="arch" type="xml">
            <xpath expr="//group/filter[@name='group_by_ftpa_state']" position="after">
                <filter name="group_by_aruba_state" string="(Aruba) E-Invoice state" context="{'group_by': 'aruba_state'}" />
            </xpath>
        </field>
    </record>

</odoo>
