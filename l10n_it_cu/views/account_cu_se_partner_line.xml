                        id="line_data_4"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-2 bg-white">
                            <h3>Social Security Datas</h3>
                        </div>
                        <div class="col-md-1" />
                        <div class="col-md-3">
                            <label for="social_security_office_fiscalcode" class="w-auto m-2" />
                        </div>
                        <div class="col-md-6">
                            <label for="social_security_office_name" class="m-2" />
                        </div>
                        <div class="col-md-2 bg-white" />
                        <div class="col-md-1" />
                        <div class="col-md-3">
                            <field name="is_social_security_required" invisible="1" />
                            <field
                                name="social_security_office_fiscalcode"
                                class="w-auto m-2"
                                attrs="{'required': [('is_social_security_required', '=', True)]}"
                            />
                        </div>
                        <div class="col-md-6">
                            <field name="social_security_office_name" class="m-2" />
                        </div>
                    </div>

                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="line_data_5"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-2 bg-white" />
                        <div class="col-md-1" />
