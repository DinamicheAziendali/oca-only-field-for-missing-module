<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_cu_se_partner_tree" model="ir.ui.view">
        <field name="name">account.cu.se.partner.tree</field>
        <field name="model">account.cu.se.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="statement_type_id" />
                <field name="fiscalcode" />
                <field name="lastname" />
                <field name="firstname" />
                <field name="gender" />
                <field name="birth_date" />
                <field name="amount_total" sum="Tot" />
                <field name="amount_ns_withholding_tax_other" sum="Tot" />
                <field name="amount_untaxed" sum="Tot" />
                <field name="amount_withholding_tax_deposit" sum="Tot" />
                <field name="error" />
                <field name="error_msg" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="view_account_cu_se_partner_search" model="ir.ui.view">
        <field name="name">account.cu.se.partner.search</field>
        <field name="model">account.cu.se.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="lastname" />
                <field name="fiscalcode" />
                <field name="firstname" />
                <filter
                    name="with_error"
                    string="With Errors"
                    domain="[('error', '=', True)]"
                />
                <group expand="0" string="Group By">
                    <filter string="Statement" name="statement_id" context="{'group_by':'statement_id'}" />
                    <filter
                        string="Statement Type"
                        name="statement_type_id"
                        context="{'group_by':'statement_type_id'}"
                    />
                    <filter string="State" name="state" context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_account_cu_se_partner_form" model="ir.ui.view">
        <field name="name">account.cu.se.partner.form</field>
        <field name="model">account.cu.se.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="reset_to_draft"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                        string="Reset to Draft"
                    />
                    <button
                        name="set_substitution"
                        type="object"
                        attrs="{'invisible': [('state', '=' ,'substitution')]}"
                        string="Set Substitution"
                    />
                    <button
                        name="set_cancelled"
                        type="object"
                        attrs="{'invisible':[('state', '=', 'cancelled')]}"
                        string="Set Cancelled"
                    />
                    <button
                        name="set_done"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'done')]}"
                        string="Set Done"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="record_dh_txt" groups="base.group_no_one" />
                        </group>
                        <group>
                            <field name="ade_protocol" />
                            <field name="ade_sequence" />
                            <field name="ade_operation" />
                        </group>
                    </group>
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="partner_data_1"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-4">
                            <label for="fiscalcode" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="lastname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="firstname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="fiscalcode" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="lastname" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="firstname" class="w-auto m-2" />
                        </div>
                    </div>
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="partner_data_2"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-1">
                            <label for="gender" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="birth_date" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <label for="birth_city" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <label for="birth_province" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <label for="special_categories" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <label for="exceptional_events" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <label for="exclusion_cases" class="w-auto m-2" />
                        </div>
                        <!-- empty-->
                        <div class="col-md-1" />
                        <div class="col-md-1">
                            <field name="gender" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="birth_date" class="w-auto m-2" />
                        </div>
                        <div class="col-md-4">
                            <field name="birth_city" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <field name="birth_province" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <field name="special_categories" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <field name="exceptional_events" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <field name="exclusion_cases" class="w-auto m-2" />
                        </div>
                        <!-- empty-->
                        <div class="col-md-1" />
                    </div>
                    <!-- Domicile 1-->
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="partner_domicile_1"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-6">
                            <label for="domicile_1_city" class="m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="domicile_1_province" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="domicile_1_city_code" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="domicile_1_city_merge_code" class="w-auto m-2" />
                        </div>
                        <div class="col-md-6">
                            <field name="domicile_1_city" class="m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="domicile_1_province" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="domicile_1_city_code" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="domicile_1_city_merge_code" class="w-auto m-2" />
                        </div>
                    </div>
                    <!-- Domicile 2-->
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="partner_domicile_2"
                        style="background-color: #e6e6e6;"
                    >
                        <div class="col-md-6">
                            <label for="domicile_2_city" class="m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="domicile_2_province" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="domicile_2_city_code" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <label for="domicile_2_city_merge_code" class="w-auto m-2" />
                        </div>
                        <div class="col-md-6">
                            <field name="domicile_2_city" class="m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="domicile_2_province" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="domicile_2_city_code" class="w-auto m-2" />
                        </div>
                        <div class="col-md-2">
                            <field name="domicile_2_city_merge_code" class="w-auto m-2" />
                        </div>
                    </div>
                    <separator string="Sections" />
                    <field name="line_ids" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_cu_se_partner" model="ir.actions.act_window">
        <field name="name">Se Partner</field>
        <field name="res_model">account.cu.se.partner</field>
        <field name="view_id" ref="l10n_it_cu.view_account_cu_se_partner_tree" />
    </record>

    <menuitem
        id="menu_cu_se_partner"
        name="CU SE Partner"
        action="l10n_it_cu.action_account_cu_se_partner"
        parent="menu_account_cu_main"
        sequence="10"
    />

</odoo>
