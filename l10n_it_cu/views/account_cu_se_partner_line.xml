                        </div>
                        <div class="col-md-2 bg-white" />
                        <div class="col-md-1" />
                        <div class="col-md-2">
                            <field name="year" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <field name="anticipation" class="w-auto m-2" />
                        </div>
                        <div class="col-md-3">
                            <field name="amount_total" class="w-auto m-2" />
                        </div>
                        <div class="col-md-3">
                            <field name="amount_ns_withholding_tax_agreement" class="w-auto m-2" />
                        </div>
                    </div>

                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="line_data_3"
                        style="background-color: #e6e6e6;"
