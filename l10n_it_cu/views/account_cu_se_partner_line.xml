                            <h3>Fiscal Datas</h3>
                        </div>
                        <div class="col-md-1" />
                        <div class="col-md-2">
                            <label for="year" class="w-auto m-2" />
                        </div>
                        <div class="col-md-1">
                            <label for="anticipation" class="w-auto m-2" />
                        </div>
                        <div class="col-md-3">
                            <label for="amount_total" class="w-auto m-2" />
                        </div>
                        <div class="col-md-3">
