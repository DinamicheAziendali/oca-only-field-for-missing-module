<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="cu_view_account_form" model="ir.ui.view">
        <field name="name">cu.account.account.form</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']/group" position="inside">
                <group string="CU" name="cu_group">
                    <field name="cu_code_ns_withholding_tax_other" />
                    <field name="cu_subject" />
                    <field
                        name="cu_subject_balance_type"
                        attrs="{'required': [('cu_subject', '=', True)], 'invisible': [('cu_subject', '=', False)]}"
                    />
                    <field
                        name="cu_subject_balance_sign"
                        attrs="{'required': [('cu_subject', '=', True)], 'invisible': [('cu_subject', '=', False)]}"
                    />
                    <field
                        name="cu_subject_fiscal_position_ids"
                        attrs="{'invisible': [('cu_subject', '=', False)]}"
                        widget="many2many_tags"
                    />
                    <field
                        name="cu_subject_journal_ids"
                        attrs="{'invisible': [('cu_subject', '=', False)]}"
                        widget="many2many_tags"
                    />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
