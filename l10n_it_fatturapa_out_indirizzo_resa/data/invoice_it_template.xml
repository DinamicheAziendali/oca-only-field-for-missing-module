<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="indirizzo_resa_line_it_dati_trasporto"
        inherit_id="l10n_it_fatturapa_out.account_invoice_it_dati_trasporto"
    >
        <xpath expr="t" position="replace">
            <t t-if="record.partner_shipping_id">
                <DatiTrasporto>
                    <!-- 2.1.9.12 -->
                    <IndirizzoResa>
                        <Indirizzo t-esc="encode_for_export(record.partner_shipping_id.street, 60)" />
                        <CAP t-esc="encode_for_export(record.partner_shipping_id.zip, 60)" />
                        <Comune t-esc="encode_for_export(record.partner_shipping_id.city, 60)" />
                        <Provincia t-esc="record.partner_shipping_id.state_id.code" />
                        <Nazione t-esc="record.partner_shipping_id.country_id.code" />
                    </IndirizzoResa>
                </DatiTrasporto>
            </t>
        </xpath>
    </template>
</odoo>
