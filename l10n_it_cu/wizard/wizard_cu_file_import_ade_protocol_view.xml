<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="wizard_cu_file_import_ade_protocol_view" model="ir.ui.view">
        <field name="name">Import ADE Protocol CU SE Certification</field>
        <field name="model">cu.file.import.ade.protocol</field>
        <field name="arch" type="xml">
            <form string="Import ADE Protocol CU SE Certification">
                <group col="4">
                    <group colspan="4">
                        <field name="ade_pdf" filename="file_name" />
                        <field name="file_name" invisible="1" />
                    </group>
                    <footer colspan="4">
                        <button name="action_import_ade_protocol" string="Import" type="object" />
                        <button special="cancel" string="Close" />
                    </footer>
                </group>
            </form>
        </field>
    </record>

    <record id="action_cu_file_import_ade_protocol" model="ir.actions.act_window">
        <field name="name">Import ADE Protocol CU SE Certification</field>
        <field name="res_model">cu.file.import.ade.protocol</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_it_cu.wizard_cu_file_import_ade_protocol_view" />
        <field name="target">new</field>
    </record>

</odoo>
