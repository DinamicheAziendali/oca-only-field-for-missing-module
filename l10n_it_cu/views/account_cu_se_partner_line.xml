                        </div>
                        <div class="col-md-2 bg-white" />
                        <div class="col-md-10">
                            <field name="income_type_code" class="w-auto m-2" />
                        </div>
                    </div>
                    <!--
                    INCOME TYPE
                    -->
                    <div
                        class="row mt16 o_settings_container mt-0"
                        id="line_data_2"
                        style="background-color: #e6e6e6;"
                    >
