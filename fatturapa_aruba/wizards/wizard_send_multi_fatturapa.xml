<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="wizard_send_multi_fatturapa_form" model="ir.ui.view">
        <field name="name">wizard.send.multi.fatturapa.form</field>
        <field name="model">wizard.send.multi.fatturapa</field>
        <field name="arch" type="xml">
            <form>
                <group string="Fatture da inviare">
                    <p>Sono incluse solo fatture in stato "Pronto"</p>
                    <p style="background-color: red">NB. Se invii piú di 30 fatture, Odoo andrà in attesa perché si possono inviare solo 30 fatture al minuto. <br/>Non chiudere o refreshare la finestra e attendi</p>
                </group>
                <newline/>
                <group>
                    <field name="attachment_out_ids" nolabel="1"/>
                </group>
                <footer>
                    <button name="send"
                            type="object"
                            string="Invia"
                            class="oe_highlight"/>
                    <button string="Annulla"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_win_wizard_send_multi_fatturapa" model="ir.actions.act_window">
        <field name="name">Invia con Aruba</field>
        <field name="binding_model_id" ref="l10n_it_fatturapa_out.model_fatturapa_attachment_out"/>
        <field name="res_model">wizard.send.multi.fatturapa</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_send_multi_fatturapa_form"/>
        <field name="target">new</field>
    </record>

</odoo>
