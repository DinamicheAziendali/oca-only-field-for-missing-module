<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="fatturapa_out_aruba_cron" model="ir.cron">
            <field name="name">Aruba FatturaPA Out Status Check</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall">1</field>
            <field name="model_id" ref="l10n_it_fatturapa_out.model_fatturapa_attachment_out"/>
            <field name="state">code</field>
            <field name="code">
# Please complete setup in Account -> Settings before activating this cron
model.cron_update_invoices_aruba_state()
            </field>
        </record>

        <record id="fatturapa_in_aruba_cron" model="ir.cron">
            <field name="name">Aruba FatturaPA In Download</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall">1</field>
            <field name="model_id" ref="l10n_it_fatturapa_in.model_fatturapa_attachment_in"/>
            <field name="state">code</field>
            <field name="code">
# Please complete setup in Account -> Settings before activating this cron
model.cron_download_invoices_via_aruba()
            </field>
        </record>

    </data>
</odoo>
