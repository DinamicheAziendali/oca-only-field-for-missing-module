<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="wizard_update_fatturapa_out_xls_form" model="ir.ui.view">
        <field name="name">wizard.update.fatturapa.out.xls.form</field>
        <field name="model">wizard.update.fatturapa.out.xls</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group>
                        <field name="sheet_name"/>
                        <field name="header_row"/>
                        <field name="first_row"/>
                        <field name="last_row"/>
                    </group>
                </group>
                <footer>
                    <button name="import_file"
                            type="object"
                            string="Importa File"
                            class="oe_highlight"/>
                    <button string="Annulla"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_update_fatturapa_out_xls" model="ir.actions.act_window">
        <field name="name">Importa Report Aruba</field>
        <field name="res_model">wizard.update.fatturapa.out.xls</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_update_fatturapa_out_xls_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_wizard_update_fatturapa_out_xls"
              action="action_wizard_update_fatturapa_out_xls"
              parent="l10n_it_fatturapa.menu_fattura_pa_receivables"/>

</odoo>