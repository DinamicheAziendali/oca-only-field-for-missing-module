                            <field name="amount_withholding_tax" class="w-auto m-2" />
                        </div>
                        <div class="col-md-3">
                            <field name="amount_withholding_tax_suspended" class="w-auto m-2" />
                        </div>
                        <div class="col-md-3">
                            <field name="amount_withholding_regional_deposit" class="w-auto m-2" />
